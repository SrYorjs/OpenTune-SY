<?xml version='1.0' encoding='utf-8'?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="original_Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/original_ic_splash_mark</item>
        <item name="postSplashScreenTheme">@style/original_Theme.mochy</item>
    </style>

    
    <style name="original_Theme.App.Starting.Icon" parent="original_Theme.App.Starting"/>

    <style name="original_Theme.mochy" parent="android:Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/original_inter</item>
        <item name="fontFamily">@font/original_inter</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/original_window_background</item>
        <item name="android:enforceNavigationBarContrast" tools:ignore="NewApi">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    
    <style name="original_Theme.Widget.mochy" parent="@android:style/Theme.DeviceDefault">
        <item name="android:fontFamily">@font/original_inter</item>
        <item name="fontFamily">@font/original_inter</item>
        <item name="android:colorBackground">#E6E1E5</item>
    </style>
</resources>
