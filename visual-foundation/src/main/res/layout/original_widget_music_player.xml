<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/original_widget_background" android:padding="16dp" android:gravity="center_vertical" android:theme="@style/original_Theme.Widget.mochy">

    
    <ImageView android:id="@+id/original_widget_album_art" android:layout_width="88dp" android:layout_height="88dp" android:scaleType="centerCrop" android:src="@mipmap/original_ic_launcher" android:contentDescription="@string/original_album_art"/>

    
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">

        
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp">

            <TextView android:id="@+id/original_widget_song_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/original_not_playing" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/original_widget_text_primary" android:maxLines="1" android:ellipsize="end"/>

            <TextView android:id="@+id/original_widget_artist_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/original_tap_to_play" android:textSize="13sp" android:textColor="@color/original_widget_text_secondary" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="2dp"/>
        </LinearLayout>

        
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">

            
            <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/original_widget_like_button_bg">

                <ImageButton android:id="@+id/original_widget_like_button" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="12dp" android:scaleType="fitCenter" android:background="@android:color/transparent" android:src="@drawable/original_ic_widget_heart_outline_nav" android:contentDescription="@string/original_like"/>
            </FrameLayout>

            
            <FrameLayout android:id="@+id/original_widget_play_pause_container" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="12dp" android:background="@drawable/original_widget_play_pill_bg">

                <ImageView android:id="@+id/original_widget_play_pause" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:src="@drawable/original_ic_widget_play" android:contentDescription="@string/original_play_pause"/>
            </FrameLayout>

        </LinearLayout>

        
        <FrameLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="12dp">

            <ImageView android:id="@+id/original_widget_progress_track" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/original_widget_progress_track" android:scaleType="fitXY"/>

            <ImageView android:id="@+id/original_widget_progress_fill" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/original_widget_progress_clip" android:scaleType="fitXY"/>
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
