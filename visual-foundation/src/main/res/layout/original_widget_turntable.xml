<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="4dp" android:theme="@style/original_Theme.Widget.mochy">

    
    <ImageView android:id="@+id/original_widget_turntable_album_art" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:scaleType="fitCenter" android:src="@drawable/original_widget_turntable_default_art" android:contentDescription="@string/original_album_art"/>

    
    <LinearLayout android:layout_width="wrap_content" android:layout_height="36dp" android:layout_gravity="top|end" android:layout_marginTop="20dp" android:layout_marginEnd="6dp" android:orientation="horizontal" android:background="@drawable/original_widget_turntable_nav_bg" android:gravity="center_vertical">

        
        <ImageButton android:id="@+id/original_widget_turntable_prev_button" android:layout_width="36dp" android:layout_height="match_parent" android:padding="8dp" android:scaleType="fitCenter" android:background="@android:color/transparent" android:src="@drawable/original_ic_widget_skip_previous" android:contentDescription="@string/original_previous"/>

        
        <ImageButton android:id="@+id/original_widget_turntable_next_button" android:layout_width="36dp" android:layout_height="match_parent" android:padding="8dp" android:scaleType="fitCenter" android:background="@android:color/transparent" android:src="@drawable/original_ic_widget_skip_next" android:contentDescription="@string/original_next"/>

    </LinearLayout>

    
    <FrameLayout android:id="@+id/original_widget_turntable_play_container" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="bottom|start" android:layout_marginBottom="12dp" android:layout_marginStart="12dp" android:background="@drawable/original_widget_turntable_play_bg">

        <ImageView android:id="@+id/original_widget_turntable_play_pause" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center" android:src="@drawable/original_ic_widget_play_secondary" android:contentDescription="@string/original_play_pause"/>
    </FrameLayout>

</FrameLayout>
